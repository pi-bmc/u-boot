# Three stores share one 24c256 EEPROM at 0x50 on the RP1 i2c1 bus (GPIO2/3),
# split by offset:
#   0x0000..0x3fff  UEFI variable blob (CONFIG_EFI_VARIABLE_I2C_STORE, written
#                   at offset 0; efi_var_i2c.c caps it at CONFIG_ENV_OFFSET so
#                   it can never grow into the env region)
#   0x4000..0x5fff  U-Boot environment (CONFIG_ENV_OFFSET, CONFIG_ENV_SIZE)
#   0x6000..0x67ff  SMBIOS tables      (CONFIG_SMBIOS_I2C_STORE_OFFSET/_SIZE)
#   0x6800..0x7fff  spare
# The env is fixed-size, so it can never creep into the SMBIOS region above it.
# The BMC - or the OS via fw_setenv - can read/rewrite these out-of-band;
# serial# in the env feeds the SMBIOS system serial (lib/smbios.c reads
# env_get("serial#")). Env falls back to the built-in default when the chip
# does not ACK (e.g. the BMC has not populated it yet), so this cannot block
# boot. CMD_EEPROM is enabled because SYS_I2C_EEPROM_ADDR_LEN is only
# configurable when it (or ID_EEPROM) is set; it also gives the 'eeprom'
# command for out-of-band debugging.
CONFIG_ENV_IS_IN_EEPROM=y
# Import the EEPROM env on top of the built-in defaults rather than replacing
# them. The BMC writes this store out-of-band knowing only the variables it
# manages, so a plain import would drop bootcmd, preboot and the load-address
# defaults, leaving the board unbootable. Trade-off: a variable in the default
# env can no longer be deleted (it is re-seeded each boot) - set it empty.
CONFIG_ENV_EEPROM_KEEP_DEFAULTS=y
CONFIG_ENV_OFFSET=0x4000
CONFIG_CMD_EEPROM=y
CONFIG_SYS_I2C_EEPROM_ADDR=0x50
CONFIG_SYS_I2C_EEPROM_ADDR_LEN=2
CONFIG_SYS_EEPROM_SIZE=32768
CONFIG_SYS_EEPROM_PAGE_WRITE_BITS=6
CONFIG_ENV_VARS_UBOOT_CONFIG=y
CONFIG_VERSION_VARIABLE=y
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
# UEFI variable persistence
# Non-volatile UEFI variables are persisted as a single serialized blob
# (ubootefi.var format: magic/length/CRC32) at offset 0 of the I2C EEPROM on
# the 40-pin header i2c bus (RP1 i2c1, GPIO2/3 - see the rp1_i2c1 node in
# bcm2712-rpi-5-b-u-boot.dtsi). The "EEPROM" may be a real 24c256 or an I2C
# slave emulated by the BMC, which can read and rewrite BootOrder/BootNext
# out-of-band. This replaces the earlier ubootefi.var-on-USB file store
# (EFI_VAR_FILE_STORE_IFACE="usb"), which itself replaced the OP-TEE
# StandAloneMM (EFI_MM_COMM_TEE) backend with its opaque RPMB store.
CONFIG_FAT_WRITE=y
CONFIG_EFI_VARIABLE_I2C_STORE=y
