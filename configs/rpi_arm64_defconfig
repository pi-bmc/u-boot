# Boot config - pure UEFI. Standard boot (bootstd) is disabled: bootcmd runs
# the EFI boot manager directly, so every boot decision flows through the
# BMC-managed BootNext/BootOrder/Boot#### variables in the I2C var store.
# Removable-media Boot#### entries (\EFI\BOOT\BOOTAA64.EFI per block device)
# are auto-generated by efi_disk/efi_setup, covering the old efiloader path.
# CONFIG_BOOTSTD is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="bootefi bootmgr"
# EFI boot manager + menu-driven UEFI variable/boot-option maintenance (eficonfig)
CONFIG_EFI_BOOTMGR=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
CONFIG_CMD_EFICONFIG=y
# Autoboot shows the bootmenu instead of the "Hit any key" prompt: UEFI Boot####
# entries plus the eficonfig maintenance menu; a pending BootNext boots straight
# away. On timeout entry 0 runs - bootmenu_0 in rpi.env, the full EFI bootmgr.
CONFIG_CMD_BOOTMENU=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_BOOTDELAY=3
CONFIG_AUTOBOOT_MENU_SHOW=y
# UEFI HTTP Boot: lets the EFI boot manager load a Boot#### URI option over HTTP
# (efidebug boot add -u <id> <label> http://host/file.efi). Selects CMD_WGET /
# CMD_DNS / BLKMAP. Note: with the legacy net stack, wget accepts http:// only
# (no https/tftp) - TFTP network boot uses the boot_snp env entry / PXE instead.
CONFIG_EFI_HTTP_BOOT=y
# Classic UEFI PXE as an EFI boot-manager option: installs a Load File protocol
# on each NIC so 'efidebug boot add -n' creates a MAC() Boot#### that DHCPs (as
# a UEFI PXE client, arch 0xB) and TFTPs the server-provided bootfile - orderable
# in BootOrder/BootNext by the BMC alongside disk and http:// entries.
CONFIG_EFI_NET_PXE_BOOT=y
# PXE
CONFIG_DHCP_PXE_CLIENTARCH=0xb
CONFIG_BOOTP_VCI_STRING="PXEClient"
CONFIG_BOOTP_PXE=y
CONFIG_BOOTP_PXE_DHCP_OPTION=y
CONFIG_BOOTP_MAY_FAIL=y
CONFIG_SERVERIP_FROM_PROXYDHCP=y
CONFIG_BOOTP_SEND_HOSTNAME=y
CONFIG_BOOTP_DNS2=y
CONFIG_BOOTP_NTPSERVER=y
# SMBIOS: tables are populated by the rpi sysinfo driver
# (board/raspberrypi/rpi/sysinfo.c) from live mailbox/DT data; VERBOSE adds
# the processor detail fields and the Type 7 cache tables.
CONFIG_GENERATE_SMBIOS_TABLE=y
CONFIG_GENERATE_SMBIOS_TABLE_VERBOSE=y
CONFIG_CMD_SMBIOS=y
# Mirror the generated SMBIOS tables into the EEPROM at 0x6000 so the BMC can
# report host inventory (product, version, serial, UUID, CPU, cache) over
# Redfish/IPMI while the host is off - the type 1 UUID exists nowhere else.
# ~551 bytes in practice; the write is skipped when the bytes are unchanged.
CONFIG_SMBIOS_I2C_STORE=y
CONFIG_SMBIOS_I2C_STORE_OFFSET=0x6000
CONFIG_SMBIOS_I2C_STORE_SIZE=0x800
CONFIG_LOCALVERSION_AUTO=n
